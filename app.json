{
  "expo": {
    "name": "StyleMe",
    "slug": "StyleMe",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "styleme",
    "userInterfaceStyle": "automatic",
    "ios": {
      "icon": "./assets/expo.icon",
      "bundleIdentifier": "app.styleme"
    },
    "android": {
      "package": "app.styleme",
      "adaptiveIcon": {
        "backgroundColor": "#F5F1EA",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "backgroundImage": "./assets/images/android-icon-background.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "output": "server",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#A85432",
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 76
        }
      ],
      "expo-sqlite",
      [
        "expo-image-picker",
        {
          "photosPermission": "StyleMe needs access to your photos so you can add garment photos to your closet.",
          "cameraPermission": "StyleMe needs camera access to photograph garments.",
          "microphonePermission": false
        }
      ]
    ],
    "extra": {
      "lookupEndpoint": ""
    },
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    }
  }
}
